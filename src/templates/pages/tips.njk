{% extends "base.njk" %}

{% set ogImage = "og-tips.jpg" %}
{% set activePage = "tips" %}

{% block seo %}
  <title>{{ t.tips.title }}</title>
  <meta name="description" content="{{ t.tips.metaDescription }}">
  <meta name="keywords" content="{{ t.tips.metaKeywords }}">
  <link rel="canonical" href="{{ site.baseUrl }}/{{ lang.prefix }}{{ page.slug }}">
{% endblock %}

{% block og %}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ t.tips.ogTitle }}">
  <meta property="og:description" content="{{ t.tips.ogDescription }}">
{% endblock %}

{% block twitter %}
  <meta name="twitter:title" content="{{ t.tips.twitterTitle }}">
  <meta name="twitter:description" content="{{ t.tips.twitterDescription }}">
{% endblock %}

{% block schema %}
  <!-- Schema.org - BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "{{ t.nav.home }}",
        "item": "{{ site.baseUrl }}/{{ lang.prefix }}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ t.tips.breadcrumbCurrent }}",
        "item": "{{ site.baseUrl }}/{{ lang.prefix }}{{ page.slug }}"
      }
    ]
  }
  </script>

  <!-- Schema.org - Article -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ t.tips.h1 }}",
    "description": "{{ t.tips.metaDescription }}",
    "url": "{{ site.baseUrl }}/{{ lang.prefix }}{{ page.slug }}",
    "datePublished": "2025-01-15",
    "dateModified": "2026-03-01",
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.siteName }}",
      "url": "{{ site.baseUrl }}"
    }
  }
  </script>
{% endblock %}

{% block hero %}
  <section class="hero hero-sm" role="banner">
    <div class="container hero-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/{{ lang.prefix }}">{{ t.nav.home }}</a> <span aria-hidden="true">/</span>
        <span aria-current="page">{{ t.tips.breadcrumbCurrent }}</span>
      </nav>
      <h1>
        {{ t.tips.h1 }}
        <span>{{ t.tips.h1Span }}</span>
      </h1>
      <p class="hero-sub">
        {{ t.tips.heroSub | safe }}
      </p>
    </div>
    <div class="wave-divider">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0 40C240 80 480 0 720 40C960 80 1200 0 1440 40V80H0V40Z" fill="white"/>
      </svg>
    </div>
  </section>
{% endblock %}

{% block content %}

    <!-- TL;DR Section -->
    <section class="section-sm" aria-label="Quick Summary">
      <div class="container">
        <div class="tldr-box">
          <ul>
{% for item in t.tips.tldr %}
            <li><strong>{{ item.strong }}</strong> {{ item.text | safe }}</li>
{% endfor %}
          </ul>
        </div>
      </div>
    </section>

    <!-- Table of Contents -->
    <section class="section-sm" aria-label="Table of Contents">
      <div class="container">
        <div class="info-card" style="max-width: 700px; margin: 0 auto;">
          <h2 style="font-size: 1.25rem; margin-bottom: 1rem;">{{ t.tips.toc.heading }}</h2>
          <ol style="columns: 2; column-gap: 2rem; padding-left: 1.25rem; line-height: 2;">
{% for item in t.tips.toc.items %}
            <li><a href="#{{ item.id }}">{{ item.label }}</a></li>
{% endfor %}
          </ol>
        </div>
      </div>
    </section>


    <!-- Tip 1: Before You Go -->
    <section class="section" id="before-you-go" aria-label="{{ t.tips.tip1.h2 }}">
      <div class="container">
        <div class="section-header fade-in">
          <span class="section-label">{{ t.tips.tip1.sectionLabel }}</span>
          <h2>{{ t.tips.tip1.h2 }}</h2>
          <p>{{ t.tips.tip1.description }}</p>
        </div>
        <div class="info-grid fade-in" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
{% for card in t.tips.tip1.cards %}
          <div class="info-card">
            <div class="info-icon" aria-hidden="true">{{ card.emoji }}</div>
            <h3>{{ card.h3 }}</h3>
            <p>{{ card.p | safe }}</p>
          </div>
{% endfor %}
        </div>
      </div>
    </section>


