{% extends "base.njk" %}

{% set ogImage = "og-tickets.jpg" %}
{% set activePage = "tickets" %}

{% block seo %}
  <!-- Primary SEO Meta -->
  <title>{{ t.tickets.title }}</title>
  <meta name="description" content="{{ t.tickets.metaDescription }}">
  <meta name="keywords" content="{{ t.tickets.metaKeywords }}">
  <link rel="canonical" href="{{ site.baseUrl }}/{{ lang.prefix }}{{ page.slug }}">
{% endblock %}

{% block og %}
  <meta property="og:title" content="{{ t.tickets.ogTitle }}">
  <meta property="og:description" content="{{ t.tickets.ogDescription }}">
{% endblock %}

{% block twitter %}
  <meta name="twitter:title" content="{{ t.tickets.twitterTitle }}">
  <meta name="twitter:description" content="{{ t.tickets.twitterDescription }}">
{% endblock %}

{% block schema %}
  <!-- Schema.org - BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "{{ t.nav.home }}",
        "item": "{{ site.baseUrl }}/{{ lang.prefix }}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ t.tickets.schema.breadcrumbCurrent }}",
        "item": "{{ site.baseUrl }}/{{ lang.prefix }}{{ page.slug }}"
      }
    ]
  }
  </script>

  <!-- Schema.org - FAQPage -->
  <script type="application/ld+json">
  {{ schemaTicketsFaq | dump | safe }}
  </script>
{% endblock %}

{% block hero %}
  <!-- Hero Section -->
  <section class="hero" role="banner">
    <div class="container hero-content">
      <div class="hero-badge">
        <span aria-hidden="true">🎟️</span>
        {{ t.tickets.hero.badge }}
      </div>
      <h1>
        {{ t.tickets.hero.h1 }}
        <span>{{ t.tickets.hero.h1Sub }}</span>
      </h1>
      <p class="hero-sub">
        {{ t.tickets.hero.sub }}
      </p>
      <div class="hero-cta-group">
        <a href="#" class="btn btn-primary btn-lg btn-pulse" data-booking>
          {{ t.tickets.hero.cta1 }}
        </a>
        <a href="#ticket-options" class="btn btn-outline btn-lg">
          {{ t.tickets.hero.cta2 }}
        </a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-number" data-base-price="{{ stickyPrice }}"><span class="pricing-currency">{{ site.baseCurrency }}</span> {{ stickyPriceFormatted }}</span>
          <span class="hero-stat-label">{{ t.tickets.hero.stats[0].label }}</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">{{ savingsPercent }}%</span>
          <span class="hero-stat-label">{{ t.tickets.hero.stats[1].label }}</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">{{ t.tickets.hero.stats[2].number }}</span>
          <span class="hero-stat-label">{{ t.tickets.hero.stats[2].label }}</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">{{ t.tickets.hero.stats[3].number }}</span>
          <span class="hero-stat-label">{{ t.tickets.hero.stats[3].label }}</span>
        </div>
      </div>
    </div>
    <div class="wave-divider">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0 40C240 80 480 0 720 40C960 80 1200 0 1440 40V80H0V40Z" fill="white"/>
      </svg>
    </div>
  </section>
{% endblock %}

{% block content %}

    <!-- Breadcrumb -->
    <nav class="section-sm" aria-label="Breadcrumb">
      <div class="container">
        <div style="font-size: 0.875rem; color: var(--gray-500);">
          <a href="/{{ lang.prefix }}" style="color: var(--primary);">{{ t.nav.home }}</a>
          <span style="margin: 0 0.5rem;">/</span>
          <span>{{ t.tickets.breadcrumbCurrent }}</span>
        </div>
      </div>
    </nav>

    <!-- TL;DR Section -->
    <section class="section-sm" aria-label="Quick Summary">
      <div class="container">
        <div class="tldr-box">
          <ul>
{% for item in t.tickets.tldr %}
{% if item.bold %}
            <li><strong>{{ item.bold }}</strong> {{ item.text | safe }}</li>
{% else %}
            <li>{{ item.text | safe }}</li>
{% endif %}
{% endfor %}
          </ul>
        </div>
      </div>
    </section>

    <!-- Ticket Options Table -->
    <section class="section" id="ticket-options" aria-label="Ticket Options">
      <div class="container">
        <div class="section-header fade-in">
          <span class="section-label">{{ t.tickets.ticketOptions.sectionLabel }}</span>
          <h2>{{ t.tickets.ticketOptions.heading }}</h2>
          <p>{{ t.tickets.ticketOptions.description }}</p>
        </div>

        <div class="table-wrapper fade-in" style="max-width: 1000px; margin: 0 auto;">
          <table>
            <thead>
              <tr>
                <th>{{ t.tickets.ticketOptions.tableHeaders[0] }}</th>
                <th>{{ t.tickets.ticketOptions.tableHeaders[1] }}</th>
                <th style="background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white;">{{ t.tickets.ticketOptions.tableHeaders[2] }}</th>
                <th>{{ t.tickets.ticketOptions.tableHeaders[3] }}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>{{ t.tickets.ticketOptions.tableRows[0].name }}</strong></td>
                <td data-base-price="{{ stickyOriginalPrice }}"><span class="pricing-currency">{{ site.baseCurrency }}</span> {{ stickyOriginalPriceFormatted }}</td>
                <td data-base-price="{{ stickyPrice }}"><strong><span class="pricing-currency">{{ site.baseCurrency }}</span> {{ stickyPriceFormatted }}</strong></td>
                <td>{{ t.tickets.ticketOptions.tableRows[0].included }}</td>
              </tr>
              <tr>
                <td><strong>{{ t.tickets.ticketOptions.tableRows[1].name }}</strong></td>
                <td>&mdash;</td>
                <td data-base-price="{{ allInclusivePrice }}"><strong><span class="pricing-currency">{{ site.baseCurrency }}</span> {{ allInclusivePriceFormatted }}</strong></td>
                <td>{{ t.tickets.ticketOptions.tableRows[1].included }}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="text-center text-sm text-muted" style="margin-top: 1rem;">
          {{ t.tickets.ticketOptions.tableFootnote }}
        </p>

        <div class="text-center" style="margin-top: 2rem;">
          <a href="#" class="btn btn-primary btn-lg btn-pulse" data-booking>{{ t.tickets.ticketOptions.cta }}</a>
        </div>
      </div>
    </section>

    <!-- Pricing Cards Highlight -->
    <section class="section section-gray" aria-label="Featured Ticket Deals">
      <div class="container">
        <div class="section-header fade-in">
          <span class="section-label">{{ t.tickets.pricingCards.sectionLabel }}</span>
          <h2>{{ t.tickets.pricingCards.heading }}</h2>
          <p>{{ t.tickets.pricingCards.description }}</p>
        </div>

        <div class="pricing-cards fade-in">

          <div class="pricing-card">
            <h3>{{ t.tickets.pricingCards.cards[0].h3 }}</h3>
            <div class="pricing-amount" style="margin: 1rem 0 0.25rem;" data-base-price="{{ stickyOriginalPrice }}">
              <span class="pricing-currency">{{ site.baseCurrency }}</span>{{ stickyOriginalPriceFormatted }}
            </div>
            <div class="pricing-period" data-price-note="gate">{{ t.tickets.pricingCards.cards[0].period }}</div>
            <div class="pricing-features">
{% for feature in t.tickets.pricingCards.cards[0].features %}
              <li>{{ feature | safe }}</li>
{% endfor %}
            </div>
            <span class="btn btn-sm" style="background: var(--gray-200); color: var(--dark-500); cursor: default;">{{ t.tickets.pricingCards.cards[0].cta }}</span>
          </div>

          <div class="pricing-card featured">
            <h3>{{ t.tickets.pricingCards.cards[1].h3 }}</h3>
            <div class="pricing-amount" style="margin: 1rem 0 0.25rem;" data-base-price="{{ stickyPrice }}">
              <span class="pricing-currency">{{ site.baseCurrency }}</span>{{ stickyPriceFormatted }}
            </div>
            <div class="pricing-period" data-price-note="online">{{ t.tickets.pricingCards.cards[1].period }}</div>
            <div class="pricing-features">
{% for feature in t.tickets.pricingCards.cards[1].features %}
              <li>{{ feature | safe }}</li>
{% endfor %}
            </div>
            <a href="#" class="btn btn-primary btn-block btn-pulse" data-booking>{{ t.tickets.pricingCards.cards[1].cta }}</a>
          </div>

          <div class="pricing-card">
            <h3>{{ t.tickets.pricingCards.cards[2].h3 }}</h3>
            <div class="pricing-amount" style="margin: 1rem 0 0.25rem;" data-base-price="{{ allInclusivePrice }}">
              <span class="pricing-currency">{{ site.baseCurrency }}</span>{{ allInclusivePriceFormatted }}
            </div>
            <div class="pricing-period" data-price-note="allinclusive">{{ t.tickets.pricingCards.cards[2].period }}</div>
            <div class="pricing-features">
{% for feature in t.tickets.pricingCards.cards[2].features %}
              <li>{{ feature | safe }}</li>
{% endfor %}
            </div>
            <a href="#" class="btn btn-primary btn-block" data-booking>{{ t.tickets.pricingCards.cards[2].cta }}</a>
          </div>

        </div>
      </div>
    </section>

    <!-- Additional Activities -->
    <section class="section" aria-label="Additional Activities">
      <div class="container">
        <div class="section-header fade-in">
          <span class="section-label">{{ t.tickets.addons.sectionLabel }}</span>
          <h2>{{ t.tickets.addons.heading }}</h2>
          <p>{{ t.tickets.addons.description }}</p>
        </div>

        <div class="info-grid fade-in" style="max-width: 900px; margin: 0 auto;">
          <div class="info-card">
            <div class="info-icon" aria-hidden="true">🏎️</div>
            <h3>{{ t.tickets.addons.items[0].h3 }}</h3>
            <p>{{ t.tickets.addons.items[0].text | safe }}</p>
          </div>
          <div class="info-card">
            <div class="info-icon" aria-hidden="true">⛳</div>
            <h3>{{ t.tickets.addons.items[1].h3 }}</h3>
            <p>{{ t.tickets.addons.items[1].text | safe }}</p>
          </div>
          <div class="info-card">
            <div class="info-icon" aria-hidden="true">🚕</div>
            <h3>{{ t.tickets.addons.items[2].h3 }}</h3>
            <p>{{ t.tickets.addons.items[2].text | safe }}</p>
          </div>
          <div class="info-card">
            <div class="info-icon" aria-hidden="true">♨️</div>
            <h3>{{ t.tickets.addons.items[3].h3 }}</h3>
            <p>{{ t.tickets.addons.items[3].text | safe }}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How to Book -->
    <section class="section section-gray" aria-label="How to Book">
      <div class="container">
        <div class="section-header fade-in">
          <span class="section-label">{{ t.tickets.howToBook.sectionLabel }}</span>
          <h2>{{ t.tickets.howToBook.heading }}</h2>
          <p>{{ t.tickets.howToBook.description | safe }}</p>
        </div>

        <div class="info-grid fade-in" style="max-width: 900px; margin: 0 auto;">
          <div class="info-card" style="text-align: center;">
            <div class="info-icon" aria-hidden="true">1️⃣</div>
            <h3>{{ t.tickets.howToBook.items[0].h3 }}</h3>
            <p>{{ t.tickets.howToBook.items[0].text | safe }}</p>
          </div>
          <div class="info-card" style="text-align: center;">
            <div class="info-icon" aria-hidden="true">2️⃣</div>
            <h3>{{ t.tickets.howToBook.items[1].h3 }}</h3>
            <p>{{ t.tickets.howToBook.items[1].text | safe }}</p>
          </div>
          <div class="info-card" style="text-align: center;">
            <div class="info-icon" aria-hidden="true">3️⃣</div>
            <h3>{{ t.tickets.howToBook.items[2].h3 }}</h3>
            <p>{{ t.tickets.howToBook.items[2].text | safe }}</p>
          </div>
          <div class="info-card" style="text-align: center;">
            <div class="info-icon" aria-hidden="true">4️⃣</div>
            <h3>{{ t.tickets.howToBook.items[3].h3 }}</h3>
            <p>{{ t.tickets.howToBook.items[3].text | safe }}</p>
          </div>
        </div>

        <div class="text-center" style="margin-top: 2rem;">
          <a href="#" class="btn btn-primary btn-lg" data-booking>{{ t.tickets.howToBook.cta }}</a>
        </div>
      </div>
    </section>

    <!-- Cancellation Policy -->
    <section class="section" aria-label="Cancellation Policy">
      <div class="container">
        <div class="section-header fade-in">
          <span class="section-label">{{ t.tickets.cancellation.sectionLabel }}</span>
          <h2>{{ t.tickets.cancellation.heading }}</h2>
        </div>

        <div class="fade-in" style="max-width: 700px; margin: 0 auto;">
          <div class="tldr-box">
            <ul>
{% for item in t.tickets.cancellation.items %}
{% if item.bold %}
              <li><strong>{{ item.bold }}</strong> {{ item.text | safe }}</li>
{% else %}
              <li>{{ item.text | safe }}</li>
{% endif %}
{% endfor %}
            </ul>
          </div>
          <p class="text-center text-sm text-muted" style="margin-top: 1rem;">
            {{ t.tickets.cancellation.footerNote | safe }}
          </p>
        </div>
      </div>
    </section>

    <!-- Money-Saving Tips -->
    <section class="section section-gray" aria-label="Money-Saving Tips">
      <div class="container">
        <div class="section-header fade-in">
          <span class="section-label">{{ t.tickets.savingsTips.sectionLabel }}</span>
          <h2>{{ t.tickets.savingsTips.heading }}</h2>
          <p>{{ t.tickets.savingsTips.description }}</p>
        </div>

        <div class="fade-in" style="max-width: 800px; margin: 0 auto;">
          <div class="info-grid" style="grid-template-columns: 1fr;">

            <div class="info-card" style="display: flex; align-items: flex-start; gap: 1rem;">
              <div class="info-icon" aria-hidden="true" style="flex-shrink: 0;">💰</div>
              <div>
                <h3>{{ t.tickets.savingsTips.tips[0].h3 }}</h3>
                <p>{{ t.tickets.savingsTips.tips[0].text | safe }}</p>
              </div>
            </div>

            <div class="info-card" style="display: flex; align-items: flex-start; gap: 1rem;">
              <div class="info-icon" aria-hidden="true" style="flex-shrink: 0;">📅</div>
              <div>
                <h3>{{ t.tickets.savingsTips.tips[1].h3 }}</h3>
                <p>{{ t.tickets.savingsTips.tips[1].text | safe }}</p>
              </div>
            </div>

            <div class="info-card" style="display: flex; align-items: flex-start; gap: 1rem;">
              <div class="info-icon" aria-hidden="true" style="flex-shrink: 0;">📱</div>
              <div>
                <h3>{{ t.tickets.savingsTips.tips[2].h3 }}</h3>
                <p>{{ t.tickets.savingsTips.tips[2].text | safe }}</p>
              </div>
            </div>

            <div class="info-card" style="display: flex; align-items: flex-start; gap: 1rem;">
              <div class="info-icon" aria-hidden="true" style="flex-shrink: 0;">🏖️</div>
              <div>
                <h3>{{ t.tickets.savingsTips.tips[3].h3 }}</h3>
                <p>{{ t.tickets.savingsTips.tips[3].text | safe }}</p>
              </div>
            </div>

            <div class="info-card" style="display: flex; align-items: flex-start; gap: 1rem;">
              <div class="info-icon" aria-hidden="true" style="flex-shrink: 0;">⏰</div>
              <div>
                <h3>{{ t.tickets.savingsTips.tips[4].h3 }}</h3>
                <p>{{ t.tickets.savingsTips.tips[4].text | safe }}</p>
              </div>
            </div>

          </div>
        </div>

        <div class="text-center" style="margin-top: 2rem;">
          <a href="/{{ lang.prefix }}tips.html" class="btn btn-primary">{{ t.tickets.savingsTips.cta }}</a>
        </div>
      </div>
    </section>

    <!-- CTA Banner 1 -->
    <section class="section" aria-label="Book Now">
      <div class="container">
        <div class="cta-banner fade-in">
          <h2>{{ t.tickets.cta1.heading }}</h2>
          <p>{{ t.tickets.cta1.text }}</p>
          <a href="#" class="btn btn-white btn-lg" data-booking>{{ t.tickets.cta1.button }}</a>
          <p class="text-sm" style="margin-top: 1rem; opacity: 0.8;">{{ t.tickets.cta1.subtextPrefix }} <strong id="countdown">...</strong></p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="section section-gray" id="faq" aria-label="Frequently Asked Questions">
      <div class="container">
        <div class="section-header fade-in">
          <span class="section-label">{{ t.tickets.faq.sectionLabel }}</span>
          <h2>{{ t.tickets.faq.heading }}</h2>
          <p>{{ t.tickets.faq.description }}</p>
        </div>

        <div class="faq-list fade-in">

{% for item in t.tickets.faq.items %}
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>{{ item.question }}</span>
              {% include "partials/faq-icon.njk" %}
            </button>
            <div class="faq-answer" role="region">
              <div class="faq-answer-inner">
                {{ item.answer | safe }}
              </div>
            </div>
          </div>

{% endfor %}
        </div>

        <div class="text-center" style="margin-top: 2rem;">
          <a href="/{{ lang.prefix }}faq.html" class="btn btn-primary">{{ t.tickets.faq.viewAll }}</a>
        </div>
      </div>
    </section>

    <!-- Full Price Guide Link -->
    <section class="section" aria-label="Full Price Guide">
      <div class="container">
        <div class="fade-in" style="max-width: 700px; margin: 0 auto; text-align: center;">
          <h2>{{ t.tickets.priceGuide.heading }}</h2>
          <p style="margin-top: 1rem;">{{ t.tickets.priceGuide.description }}</p>
          <div style="margin-top: 1.5rem;">
            <a href="/{{ lang.prefix }}blog/{{ t.tickets.priceGuide.blogSlug }}" class="btn btn-primary btn-lg">{{ t.tickets.priceGuide.button }}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="section section-gray" aria-label="Final Call to Action">
      <div class="container">
        <div class="cta-banner fade-in">
          <h2>{{ t.tickets.cta2.heading }}</h2>
          <p>{{ t.tickets.cta2.text }}</p>
          <a href="#" class="btn btn-white btn-lg" data-booking>{{ t.tickets.cta2.button }}</a>
        </div>
      </div>
    </section>

{% endblock %}
