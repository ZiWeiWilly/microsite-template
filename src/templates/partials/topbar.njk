  <!-- Language Bar -->
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="selector" id="langSelector">
        <button class="selector-btn" aria-expanded="false" aria-haspopup="listbox">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z"/></svg>
          <span class="current-lang-label">{{ lang.label }}</span>
          <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="selector-dropdown" role="listbox" id="langMenu">
{%- for altLang in site.languages %}
          <a href="/{{ altLang.prefix }}{{ '' if page.slug == 'index.html' else page.slug }}" lang="{{ altLang.code }}" role="option">{{ altLang.label }}</a>
{%- endfor %}
        </div>
      </div>
      <div class="selector" id="currencySelector">
        <button class="selector-btn" aria-expanded="false" aria-haspopup="listbox">
          <span class="current-currency-label">THB ฿</span>
          <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="selector-dropdown" role="listbox" id="currencyMenu">
{%- for cur in site.currencies %}
          <button data-currency="{{ cur.code }}"{% if cur.code == "THB" %} class="active"{% endif %} role="option">{{ cur.code }} {{ cur.symbol }} {{ cur.label }}</button>
{%- endfor %}
        </div>
      </div>
    </div>
  </div>
